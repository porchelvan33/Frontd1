pipeline {
    agent any

    tools {
        nodejs 'NodeJS'
    }

    environment {
        // ---------- Docker Hub ----------
        DOCKERHUB_USER = 'porchelvan32'

        // ---------- AWS ----------
        AWS_DEFAULT_REGION = 'ap-south-1'
        S3_BUCKET = 'frontd1-frontend-porchelvan'
        CLOUDFRONT_DISTRIBUTION_ID = 'E2YUXO4I47OT3F'

        // ---------- EC2 ----------
        EC2_USER = 'ubuntu'
        EC2_HOST = '3.108.254.79'
        DEPLOY_PATH = '/home/ubuntu/Frontd1/backend'
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/porchelvan33/Frontd1.git'
            }
        }

        stage('Verify Environment') {
            steps {
                sh '''
                    echo "===== Versions ====="

                    node --version
                    npm --version
                    docker --version
                    aws --version
                '''
            }
        }

        /* =========================================
           FRONTEND
           ========================================= */

        stage('Install Frontend') {
            steps {
                dir('frontend') {
                    sh 'npm ci'
                }
            }
        }

        stage('Build Frontend') {
            steps {
                dir('frontend') {
                    sh 'npm run build'
                }
            }
        }

        /* =========================================
           DOCKER LOGIN
           ========================================= */

        stage('Docker Login') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {
                    sh '''
                        echo "$DOCKER_PASS" | \
                        docker login -u "$DOCKER_USER" \
                        --password-stdin
                    '''
                }
            }
        }  
        stage('Check Project Structure') {
                steps {
                   sh '''
                      echo "Current directory:"
                       pwd

                       echo "Workspace files:"
                       ls -la

                       echo "Directory structure:"
                       find . -maxdepth 3 -type f -name Dockerfile -print
                    '''
                 }
             }


        /* =========================================
           BUILD BACKEND IMAGES
           ========================================= */

        stage('Build Backend Images') {
            steps {
                sh '''
                    docker build \
                    -t $DOCKERHUB_USER/frontd1-api-gateway:${BUILD_NUMBER} \
                    -t $DOCKERHUB_USER/frontd1-api-gateway:latest \
                    backend/api-gateway_1784010924579

                    docker build \
                    -t $DOCKERHUB_USER/frontd1-auth-service:${BUILD_NUMBER} \
                    -t $DOCKERHUB_USER/frontd1-auth-service:latest \
                    backend/auth-service_1784011000189

                    docker build \
                    -t $DOCKERHUB_USER/frontd1-task-service:${BUILD_NUMBER} \
                    -t $DOCKERHUB_USER/frontd1-task-service:latest \
                    backend/task-service

                    docker build \
                    -t $DOCKERHUB_USER/frontd1-notification-service:${BUILD_NUMBER} \
                    -t $DOCKERHUB_USER/frontd1-notification-service:latest \
                    backend/notification-service

                    docker build \
                    -t $DOCKERHUB_USER/frontd1-report-service:${BUILD_NUMBER} \
                    -t $DOCKERHUB_USER/frontd1-report-service:latest \
                    backend/report-service
                '''
            }
        }

        

        /* =========================================
           DEPLOY BACKEND TO EC2
           ========================================= */

        stage('Deploy Backend') {
            steps {
                sshagent(credentials: ['ec2-ssh-key']) {

                    sh '''
                        ssh -o StrictHostKeyChecking=no \
                        $EC2_USER@$EC2_HOST "

                            cd $DEPLOY_PATH

                            echo 'Pulling latest Docker images...'
                            docker compose pull

                            echo 'Starting containers...'
                            docker compose up -d

                            echo 'Removing unused images...'
                            docker image prune -f

                            echo 'Container status:'
                            docker compose ps
                        "
                    '''
                }
            }
        }

        /* =========================================
           BACKEND HEALTH CHECK
           ========================================= */

        stage('Backend Health Check') {
            steps {
                sshagent(credentials: ['ec2-ssh-key']) {

                    sh '''
                        ssh -o StrictHostKeyChecking=no \
                        $EC2_USER@$EC2_HOST "

                            echo 'Checking API Gateway...'

                            sleep 10

                            curl --fail \
                            http://localhost:5000/health
                        "
                    '''
                }
            }
        }

        /* =========================================
           FRONTEND DEPLOYMENT
           ========================================= */

        stage('Deploy Frontend to S3') {
            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'aws-credentials',
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    )
                ]) {

                    dir('frontend') {

                        sh '''
                            aws s3 sync dist/ \
                            s3://$S3_BUCKET/ \
                            --delete
                        '''
                    }
                }
            }
        }

        /* =========================================
           CLOUDFRONT
           ========================================= */

        stage('CloudFront Invalidation') {
            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'aws-credentials',
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    )
                ]) {

                    sh '''
                        aws cloudfront create-invalidation \
                        --distribution-id $CLOUDFRONT_DISTRIBUTION_ID \
                        --paths "/*"
                    '''
                }
            }
        }

        /* =========================================
           FINAL CHECK
           ========================================= */

        stage('Deployment Status') {
            steps {

                echo '''
                ==========================================
                    FRONTD1 DEPLOYMENT COMPLETED
                ==========================================

                Backend:
                Docker Images -> Docker Hub -> EC2

                Frontend:
                Build -> S3 -> CloudFront

                API:
                CloudFront /api/*
                       |
                       v
                      ALB
                       |
                       v
                  API Gateway
                       |
                 Microservices
                       |
                    MongoDB

                ==========================================
                '''
            }
        }
    }

    post {

        success {
            echo 'Deployment completed successfully.'
        }

        failure {
            echo 'Deployment failed. Check the Jenkins console output.'
        }

        always {
            sh 'docker logout || true'
        }
    }
}

